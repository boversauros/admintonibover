{
  "name": "admintonibover-admin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:browser-artifacts": "node scripts/check-browser-artifacts.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "audit:dependencies": "pnpm audit --prod --audit-level high",
    "lambda:build": "node --import tsx scripts/build-foundation-lambda.ts",
    "lambda:validate": "node --import tsx scripts/build-foundation-lambda.ts --check",
    "reader:build": "node --import tsx scripts/build-reader-lambda.ts",
    "reader:validate": "node --import tsx scripts/build-reader-lambda.ts --check",
    "reader:prod:synth": "node --import tsx scripts/synthesize-production-site-reader.ts",
    "reader:prod:validate": "pnpm reader:prod:synth -- --check",
    "dev:refresh": "node --import tsx scripts/refresh-dev-from-prod.ts",
    "infra:synth": "node --import tsx scripts/synthesize-infrastructure.ts",
    "infra:validate": "node --import tsx scripts/synthesize-infrastructure.ts --check",
    "ci": "pnpm check:secrets && pnpm infra:validate && pnpm reader:prod:validate && pnpm check:design-tokens && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:browser-artifacts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1101.0",
    "@aws-sdk/client-dynamodb": "3.1101.0",
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/lib-dynamodb": "3.1101.0",
    "@aws-sdk/s3-request-presigner": "3.1101.0",
    "jose": "6.2.4",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.69.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1101.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "25.0.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.28.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "^3.7.4",
    "tailwindcss": "4.1.18",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
