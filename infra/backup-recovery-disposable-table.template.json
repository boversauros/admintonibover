{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Disposable development DynamoDB table for an AWS backup recovery rehearsal.",
  "Parameters": {
    "PurposeConfirmation": {
      "Type": "String",
      "AllowedValues": ["AWS-BACKUP-RESTORE"],
      "Description": "Explicit confirmation that this stack is disposable and development-only."
    },
    "RecoveryRunId": {
      "Type": "String",
      "AllowedPattern": "^recovery-[a-z0-9-]{8,40}$",
      "Description": "Unique run identifier used to bind restore and cleanup operations."
    }
  },
  "Resources": {
    "RecoveryTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "BillingMode": "PAY_PER_REQUEST",
        "TableClass": "STANDARD",
        "DeletionProtectionEnabled": false,
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": false
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "admintonibover"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          },
          {
            "Key": "ManagedBy",
            "Value": "iac"
          },
          {
            "Key": "Owner",
            "Value": "orio"
          },
          {
            "Key": "Purpose",
            "Value": {
              "Ref": "PurposeConfirmation"
            }
          },
          {
            "Key": "RecoveryRunId",
            "Value": {
              "Ref": "RecoveryRunId"
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "TableArn": {
      "Description": "Disposable backup recovery table ARN.",
      "Value": {
        "Fn::GetAtt": ["RecoveryTable", "Arn"]
      }
    },
    "TableName": {
      "Description": "Disposable backup recovery table name.",
      "Value": {
        "Ref": "RecoveryTable"
      }
    }
  }
}
