{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/boversauros/admintonibover/blob/main/docs/schemas/dynamodb-backup-v1.schema.json",
  "title": "admintonibover DynamoDB backup v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "exportedAt", "manifest", "items"],
  "properties": {
    "schema": {
      "const": "https://github.com/boversauros/admintonibover/blob/main/docs/schemas/dynamodb-backup-v1.schema.json"
    },
    "version": { "const": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemCount", "pageCount", "revision", "sha256", "keySchema"],
      "properties": {
        "itemCount": { "type": "integer", "minimum": 0 },
        "pageCount": { "type": "integer", "minimum": 1 },
        "revision": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "keySchema": {
          "type": "array",
          "prefixItems": [{ "const": "PK" }, { "const": "SK" }],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["PK", "SK"],
        "properties": {
          "PK": { "type": "string", "minLength": 1 },
          "SK": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  }
}
